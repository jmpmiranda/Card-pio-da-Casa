async function goToWeek(monday){
  currentWeekStart = monday;
  const w = await loadWeek(monday);
  currentSlots = w.slots;
  currentPeople = w.pessoas;
  renderWeekRange();
  renderDayTabs();
  renderDaySlots();
}
document.getElementById('prev-week').onclick = ()=>goToWeek(addDays(currentWeekStart,-7));
document.getElementById('next-week').onclick = ()=>goToWeek(addDays(currentWeekStart,7));

function renderWeekRange(){
  const end = addDays(currentWeekStart,6);
  document.getElementById('week-range').textContent = `${fmtShort(currentWeekStart)} – ${fmtShort(end)}`;
}

function renderDayTabs(){
  const box = document.getElementById('daytabs');
  box.innerHTML = '';
  DAYS.forEach((day,i)=>{
    const tab = document.createElement('div');
    tab.className = 'daytab' + (day===selectedDay ? ' active' : '');
    tab.innerHTML = `<strong>${DAY_LABELS[day]}</strong><span>${fmtShort(addDays(currentWeekStart,i))}</span>`;
    tab.onclick = ()=>{ selectedDay = day; renderDayTabs(); renderDaySlots(); };
    box.appendChild(tab);
  });
}

function renderDaySlots(){
  const box = document.getElementById('dayslots');
  box.innerHTML = '';
  MEALS.forEach(meal=>{
    const key = `${selectedDay}-${meal}`;
    const ids = currentSlots[key] || [];
    const dishes = ids.map(id=>recipeById(id)).filter(Boolean);
    const hadRemoved = ids.length > dishes.length;
    const cell = document.createElement('div');
    cell.className = 'slot';
    let html = `<div class="mealname">${MEAL_LABELS[meal]}</div>`;
    if(dishes.length===0){
      const rule = rules[key];
      html += `<div style="color:var(--ink-soft); font-size:0.92rem; padding:6px 0;">${rule ? `Categoria fixa: ${escapeHtml(rule)}` : 'Nada escolhido ainda'}</div>`;
    } else {
      dishes.forEach(r=>{
        html += `
          <div class="dish-row" data-id="${r.id}">
            <span class="dish-dot" style="background:${categoryColor(r.categoria)}"></span>
            <div style="flex:1;">
              <div class="dish-name">${escapeHtml(r.name)}</div>
              ${r.categoria ? `<div class="dish-cat">${escapeHtml(r.categoria)}</div>` : ''}
            </div>
            <button class="dish-x" title="Remover">✕</button>
          </div>`;
      });
      if(hadRemoved){
        html += `<div style="color:var(--ink-soft); font-size:0.8rem; padding:6px 0;">Uma receita desse espaço foi excluída da lista.</div>`;
      }
      const peopleVal = currentPeople[key] || '';
      html += `<div style="display:flex; align-items:center; gap:8px; margin-top:10px; font-size:0.85rem; color:var(--ink-soft);">
        Pra quantas pessoas?
        <input type="text" class="people-input" inputmode="numeric" data-key="${key}" value="${peopleVal}" placeholder="4" style="width:56px; border:1px solid var(--line); border-radius:6px; padding:5px 8px; font-family:'Work Sans',sans-serif;">
      </div>`;
    }
    html += `
      <div class="slot-actions">
        <button class="act-add">+ Adicionar receita</button>
        ${dishes.length ? `<button class="act-edit">Editar</button>` : ''}
        ${dishes.length>=2 ? `<button class="act-combo">💾 Salvar como combo</button>` : ''}
      </div>`;
    cell.innerHTML = html;

    cell.querySelectorAll('.dish-x').forEach(btn=>{
      btn.onclick = async ()=>{
        const rid = btn.closest('.dish-row').dataset.id;
        currentSlots[key] = (currentSlots[key]||[]).filter(id=>id!==rid);
        await persistWeek();
        renderDaySlots();
      };
    });
    const peopleInput = cell.querySelector('.people-input');
    if(peopleInput){
      peopleInput.onchange = async ()=>{
        const n = parseFloat(peopleInput.value);
        if(n > 0) currentPeople[key] = n; else delete currentPeople[key];
        await persistWeek();
      };
    }
    cell.querySelector('.act-add').onclick = ()=>openSlotPicker(selectedDay, meal);
    if(dishes.length){
      cell.querySelector('.act-edit').onclick = ()=>{
        if(dishes.length===1){ openRecipeForm(dishes[0]); }
        else openDishChooser(dishes, r=>openRecipeForm(r));
      };
    }
    if(dishes.length>=2){
      cell.querySelector('.act-combo').onclick = ()=>openSaveComboPrompt(dishes.map(d=>d.id));
    }
    box.appendChild(cell);
  });
}

