function showGateError(id, msg){
  const el = document.getElementById(id);
  el.textContent = msg;
  el.style.display = 'block';
}
function hideGateError(id){ document.getElementById(id).style.display = 'none'; }

document.getElementById('auth-switch-link').onclick = ()=>{
  authMode = authMode === 'login' ? 'signup' : 'login';
  document.getElementById('auth-title').textContent = authMode === 'login' ? 'Entrar' : 'Criar conta';
  document.getElementById('auth-submit').textContent = authMode === 'login' ? 'Entrar' : 'Criar conta';
  document.getElementById('auth-switch-text').textContent = authMode === 'login' ? 'Ainda não tem conta?' : 'Já tem conta?';
  document.getElementById('auth-switch-link').textContent = authMode === 'login' ? 'Criar conta' : 'Entrar';
