  recipes = error ? [] : data.map(r=>({
    id:r.id, name:r.name, ingredientes:r.ingredientes||[], instructions:r.instructions||'',
    categoria:r.categoria||'', porcoes:r.porcoes||4, meals:r.meals||[], createdAt:r.created_at
  }));
}
async function createRecipeRow(data){
  const { data: row, error } = await sb.from('recipes').insert({
    household_id: currentHouseholdId, name:data.name, ingredientes:data.ingredientes,
    instructions:data.instructions, categoria:data.categoria, porcoes:data.porcoes, meals:data.meals
  }).select().single();
  if(error) throw error;
  return row.id;
}
async function updateRecipeRow(id, data){
  const { error } = await sb.from('recipes').update({
    name:data.name, ingredientes:data.ingredientes, instructions:data.instructions,
    categoria:data.categoria, porcoes:data.porcoes, meals:data.meals
  }).eq('id', id);
