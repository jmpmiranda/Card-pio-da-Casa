        alreadyIn.add(r.id);
        await persistWeek();
        renderDaySlots();
        renderList(overlay.querySelector('#picker-search') ? overlay.querySelector('#picker-search').value : '');
      };
      list.appendChild(item);
    });
  }

  if(options.length){
    renderList('');
    const searchInput = overlay.querySelector('#picker-search');
    searchInput.oninput = ()=>renderList(searchInput.value);
    overlay.querySelector('#picker-suggest').onclick = async ()=>{
      const suggestion = await suggestComboForSlot(day, meal, Array.from(alreadyIn));
      if(suggestion && suggestion.length){
        const set = new Set(currentSlots[key] || []);
        suggestion.forEach(r=>set.add(r.id));
        currentSlots[key] = Array.from(set);
        await persistWeek();
        renderDaySlots();
      }
      overlay.remove();
    };
  }
}

async function suggestComboForSlot(day, meal, excludeIds=[]){
  const key = `${day}-${meal}`;
  const requiredCategory = rules[key];
  const mealOk = recipesForMeal(meal);
  const mealOkIds = new Set(mealOk.map(r=>r.id));
  const pastWeeksList = await loadAllPastWeeksWithDates();

  function usableCombo(recipeIds){
    const dishes = recipeIds.map(id=>recipeById(id)).filter(Boolean);
    if(dishes.length !== recipeIds.length) return null;
    if(dishes.some(d=>excludeIds.includes(d.id))) return null;
    if(!dishes.every(d=>mealOkIds.has(d.id))) return null;
    if(requiredCategory && !dishes.some(d=>(d.categoria||'').toLowerCase()===requiredCategory.toLowerCase())) return null;
    return dishes;
  }

  // 1) receitas ensinadas manualmente como combo
  const teachableCombos = combos.map(c=>({ src:'combo', ids:c.recipeIds })).filter(c=>usableCombo(c.ids));
  // 2) combinações que já apareceram juntas em semanas passadas
  const historyCounts = {};
  pastWeeksList.forEach(({weekStart, slots})=>{
    const ids = (slots[key]||[]).slice().sort();
    if(ids.length<2) return;
    const k = ids.join('|');
    if(!historyCounts[k]) historyCounts[k] = { ids, lastWeek:'', count:0 };
    historyCounts[k].count++;
    if(weekStart > historyCounts[k].lastWeek) historyCounts[k].lastWeek = weekStart;
  });
  const historicCombos = Object.values(historyCounts)
    .filter(h=>usableCombo(h.ids))
    .sort((a,b)=> a.lastWeek < b.lastWeek ? -1 : 1); // menos usada recentemente primeiro

  if(teachableCombos.length){
    const pick = teachableCombos[Math.floor(Math.random()*teachableCombos.length)];
    return usableCombo(pick.ids);
  }
  if(historicCombos.length){
    return usableCombo(historicCombos[0].ids);
  }

  // 3) sem combo conhecido: sugere um único prato, priorizando o que não aparece há mais tempo
  let candidates = mealOk.filter(r=>!excludeIds.includes(r.id));
  if(requiredCategory){
    const matching = candidates.filter(r => (r.categoria||'').toLowerCase() === requiredCategory.toLowerCase());
    if(matching.length) candidates = matching;
  }
  if(candidates.length===0) return [];
  const lastUsedWeek = {};
  pastWeeksList.forEach(({weekStart, slots})=>{
    Object.values(slots).forEach(ids=>{
      (ids||[]).forEach(id=>{
        if(!lastUsedWeek[id] || weekStart > lastUsedWeek[id]) lastUsedWeek[id] = weekStart;
      });
    });
  });
  const withRecency = candidates.map(r => ({ r, last: lastUsedWeek[r.id] || '' }));
  const oldest = withRecency.reduce((min, w) => w.last < min ? w.last : min, withRecency[0].last);
  const tier = withRecency.filter(w => w.last === oldest);
  const pick = tier[Math.floor(Math.random()*tier.length)];
  return [pick.r];
}

