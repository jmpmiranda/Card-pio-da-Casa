function buildShoppingItems(){
  const groups = {}; // key: nome|unidade -> {nome, unidade, total, semQtd}
  DAYS.forEach(day=>{
    MEALS.forEach(meal=>{
      const key = `${day}-${meal}`;
      const ids = currentSlots[key] || [];
      const wantedPeople = currentPeople[key] || 4;
      ids.forEach(id=>{
        const r = recipeById(id);
        if(!r || !r.ingredientes) return;
        const basePorcoes = r.porcoes || 4;
        const factor = wantedPeople / basePorcoes;
        r.ingredientes.forEach(ing=>{
          const gkey = `${ing.nome.toLowerCase()}|${ing.unidade}`;
          if(!groups[gkey]) groups[gkey] = { nome: ing.nome, unidade: ing.unidade, total: 0, semQtd: false, count: 0 };
          const n = parseFloat(ing.quantidade);
          if(!isNaN(n)) groups[gkey].total += n * factor; else groups[gkey].semQtd = true;
          groups[gkey].count += 1;
        });
      });
    });
  });
  return Object.values(groups).sort((a,b)=>a.nome.localeCompare(b.nome));
}

