};

document.getElementById('auth-submit').onclick = async ()=>{
  hideGateError('auth-error');
  const email = document.getElementById('auth-email').value.trim();
  const password = document.getElementById('auth-password').value;
  if(!email || !password){ showGateError('auth-error','Preenche e-mail e senha.'); return; }
  const btn = document.getElementById('auth-submit');
  btn.disabled = true; btn.textContent = 'Aguenta aí...';
  try{
    const { data, error } = authMode === 'login'
      ? await sb.auth.signInWithPassword({ email, password })
      : await sb.auth.signUp({ email, password });
    if(error) throw error;
    if(authMode === 'signup' && !data.session){
      showGateError('auth-error','Conta criada! Se o projeto exigir confirmação por e-mail, confirma antes de entrar.');
      btn.disabled = false; btn.textContent = 'Criar conta';
      return;
    }
    await onLoggedIn(data.user);
  }catch(err){
    showGateError('auth-error', err.message || 'Não deu pra entrar. Confere e-mail e senha.');
  }
  btn.disabled = false; btn.textContent = authMode === 'login' ? 'Entrar' : 'Criar conta';
};

document.getElementById('logout-btn').onclick = async ()=>{
