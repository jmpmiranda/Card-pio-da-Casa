const UNIDADES = ['g','kg','ml','l','un','xíc','csopa','cchá','pitada'];
const UNIDADE_LABELS = {g:'g',kg:'kg',ml:'ml',l:'l',un:'un',xíc:'xícara',csopa:'colher sopa',cchá:'colher chá',pitada:'pitada'};
const CATEGORY_COLORS = ['#D64545','#3E8E7E','#E0982A','#5B7FDB','#8B5FBF','#4E9A5C','#D6588B','#4FA8C9'];
function categoryColor(cat){
  if(!cat) return '#9AA090';
  let h = 0;
  for(let i=0;i<cat.length;i++) h = (h*31 + cat.charCodeAt(i)) >>> 0;
  return CATEGORY_COLORS[h % CATEGORY_COLORS.length];
}

let recipes = [];
let rules = {};
let combos = [];
let currentWeekStart = getMonday(new Date());
let selectedDay = 'seg';
