<style>
  :root{
    --bg:#EAF3E1;
    --paper:#FFFFFF;
    --ink:#2B2320;
    --ink-soft:#6B6259;
    --line:#CFE0C4;
    --plum:#A23B55;
    --plum-dark:#7A2B41;
    --mustard:#E0982A;
    --mustard-soft:#FCE4B8;
    --sage:#4E9A5C;
    --shadow: 0 1px 0 rgba(43,35,32,0.06);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:'Work Sans', sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.serif{ font-family:'Fraunces', serif; }
  .wrap{ max-width:920px; margin:0 auto; padding:28px 20px 80px; }

  header.top{
    display:flex; align-items:baseline; justify-content:space-between;
    gap:16px; flex-wrap:wrap; margin-bottom:22px;
    border-bottom:1px solid var(--line); padding-bottom:18px;
  }
  header.top h1{
    font-size:2rem; font-weight:600; margin:0; letter-spacing:-0.01em;
    color:var(--plum-dark);
  }
  header.top p{ margin:4px 0 0; color:var(--ink-soft); font-size:0.95rem; }

  nav.tabs{ display:flex; gap:6px; margin-bottom:22px; }
  nav.tabs button{
    font-family:'Work Sans', sans-serif; font-size:0.95rem; font-weight:500;
    background:transparent; border:1px solid var(--line); color:var(--ink-soft);
    padding:8px 16px; border-radius:20px; cursor:pointer; transition:all .15s ease;
  }
  nav.tabs button.active{
    background:var(--plum); border-color:var(--plum); color:var(--paper);
  }
  nav.tabs button:not(.active):hover{ border-color:var(--sage); color:var(--ink); }

  /* WEEK NAV */
  .weeknav{
    display:flex; align-items:center; justify-content:space-between;
    margin-bottom:18px; gap:12px; flex-wrap:wrap;
  }
  .weeknav .range{ font-size:1.05rem; font-weight:500; }
  .weeknav .btns{ display:flex; gap:8px; }
  .iconbtn{
    background:var(--paper); border:1px solid var(--line); border-radius:8px;
    width:36px; height:36px; display:flex; align-items:center; justify-content:center;
    cursor:pointer; font-size:1rem; color:var(--ink);
  }
  .iconbtn:hover{ border-color:var(--sage); }
  .primary-btn{
    background:var(--plum); color:var(--paper); border:none; border-radius:8px;
    padding:9px 16px; font-family:'Work Sans',sans-serif; font-weight:500; font-size:0.92rem;
    cursor:pointer; display:inline-flex; align-items:center; gap:6px;
  }
  .primary-btn:hover{ background:var(--plum-dark); }
  .ghost-btn{
    background:transparent; color:var(--plum); border:1px solid var(--plum);
    border-radius:8px; padding:8px 14px; font-family:'Work Sans',sans-serif; font-weight:500;
    font-size:0.88rem; cursor:pointer;
  }
  .ghost-btn:hover{ background:var(--plum); color:var(--paper); }

  /* DAY TABS + SLOTS */
  .daytabs{
    display:flex; gap:6px; overflow-x:auto; padding-bottom:4px; margin-bottom:16px;
    -webkit-overflow-scrolling:touch;
  }
  .daytab{
    flex:0 0 auto; background:var(--paper); border:1px solid var(--line); border-radius:10px;
    padding:8px 14px; text-align:center; cursor:pointer; font-family:'Work Sans',sans-serif;
  }
  .daytab strong{ display:block; font-size:0.92rem; font-weight:600; color:var(--ink); }
  .daytab span{ font-size:0.72rem; color:var(--ink-soft); }
  .daytab.active{ background:var(--plum); border-color:var(--plum); }
  .daytab.active strong, .daytab.active span{ color:var(--paper); }
  .daytab:hover:not(.active){ border-color:var(--sage); }

  .dayslots{ display:flex; flex-direction:column; gap:14px; }
  .slot{
    background:var(--paper); border:1px solid var(--line); border-radius:12px;
    padding:16px; box-shadow:var(--shadow);
  }
  .slot .mealname{ font-size:0.8rem; font-weight:600; color:var(--ink-soft); margin-bottom:6px; }
  .slot .rname{ font-size:1.1rem; font-weight:600; line-height:1.3; font-family:'Fraunces',serif; }
  .slot .rcat{ font-size:0.78rem; color:var(--mustard); margin-top:4px; }
  .slot .slot-actions{ display:flex; gap:10px; margin-top:12px; flex-wrap:wrap; }
  .slot .slot-actions button{
    background:none; border:none; padding:0; cursor:pointer; font-size:0.85rem;
    font-family:'Work Sans',sans-serif; font-weight:500; color:var(--plum); text-decoration:underline;
  }
  .slot.empty-slot{
    border-style:dashed; display:flex; align-items:center; justify-content:center;
    min-height:70px; color:var(--ink-soft); cursor:pointer; font-size:0.92rem;
  }
  .slot.empty-slot:hover{ border-color:var(--sage); }
  .slot.empty-slot .mealname{ position:absolute; }

  .dish-row{
    display:flex; align-items:center; gap:10px; padding:10px 0;
    border-bottom:1px solid var(--line);
  }
  .dish-row:last-of-type{ border-bottom:none; }
  .dish-dot{ width:10px; height:10px; border-radius:50%; flex:0 0 auto; }
  .dish-row .dish-name{ font-weight:600; font-family:'Fraunces',serif; font-size:1rem; flex:1; }
  .dish-row .dish-cat{ font-size:0.72rem; color:var(--ink-soft); }
  .dish-row .dish-x{ background:none; border:none; color:var(--ink-soft); font-size:1rem; cursor:pointer; padding:2px 4px; }
  .dish-row .dish-x:hover{ color:#9B3A3A; }
  .cat-chip{
    display:inline-flex; align-items:center; gap:5px; font-size:0.72rem; font-weight:600;
    padding:2px 9px; border-radius:12px; color:#fff;
  }

  .combo-item{
    border:1px solid var(--line); border-radius:8px; padding:10px 12px; margin-bottom:8px; cursor:pointer;
  }
  .combo-item:hover{ border-color:var(--sage); background:#F5F7EF; }
  .combo-item .combo-title{ font-weight:600; font-size:0.9rem; }
  .combo-item .combo-items{ font-size:0.78rem; color:var(--ink-soft); margin-top:2px; }
  .combo-section-title{ font-size:0.8rem; font-weight:600; color:var(--ink-soft); margin:6px 0 8px; text-transform:uppercase; letter-spacing:.03em; }

  /* CHAT / PERGUNTAR TAB */
  .chat-wrap{ display:flex; flex-direction:column; height:60vh; min-height:360px; }
  .chat-log{ flex:1; overflow-y:auto; padding:6px 2px; display:flex; flex-direction:column; gap:12px; }
  .chat-msg{ max-width:85%; padding:10px 14px; border-radius:14px; font-size:0.92rem; line-height:1.45; white-space:pre-wrap; }
  .chat-msg.user{ align-self:flex-end; background:var(--plum); color:#fff; border-bottom-right-radius:4px; }
  .chat-msg.assistant{ align-self:flex-start; background:var(--paper); border:1px solid var(--line); border-bottom-left-radius:4px; }
  .chat-msg.thinking{ align-self:flex-start; color:var(--ink-soft); font-style:italic; }
  .chat-input-row{ display:flex; gap:8px; margin-top:12px; }
  .chat-input-row input{
    flex:1; border:1px solid var(--line); border-radius:20px; padding:11px 16px;
    font-family:'Work Sans',sans-serif; font-size:0.92rem;
  }
  .chat-input-row button{
    background:var(--plum); color:#fff; border:none; border-radius:20px; padding:0 20px;
    font-family:'Work Sans',sans-serif; font-weight:500; cursor:pointer;
  }
  .chat-suggestions{ display:flex; gap:8px; flex-wrap:wrap; margin-bottom:10px; }
  .chat-chip{
    background:var(--paper); border:1px solid var(--line); border-radius:16px; padding:6px 12px;
    font-size:0.8rem; cursor:pointer; color:var(--ink);
  }
  .chat-chip:hover{ border-color:var(--sage); }

  .weekfooter{ display:flex; justify-content:flex-end; margin-top:6px; }

  /* LIBRARY */
  .libgrid{
    display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
    gap:14px; margin-top:6px;
  }
  .rcard{
    background:var(--paper); border:1px solid var(--line); border-radius:12px;
    padding:16px; cursor:pointer; box-shadow:var(--shadow);
  }
  .rcard:hover{ border-color:var(--sage); }
  .rcard h3{ margin:0 0 6px; font-size:1.05rem; font-weight:600; }
  .rcard .meals{ font-size:0.75rem; color:var(--mustard); font-weight:600; }
  .rcard p{ margin:8px 0 0; font-size:0.82rem; color:var(--ink-soft); line-height:1.4;
    display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .empty-lib{
    text-align:center; padding:50px 20px; color:var(--ink-soft);
  }
  .empty-lib h3{ color:var(--ink); margin-bottom:8px; }

  /* MODAL */
  .overlay{
    position:fixed; inset:0; background:rgba(38,49,42,0.45);
    display:flex; align-items:center; justify-content:center; padding:20px;
    z-index:50;
  }
  .modal{
    background:var(--paper); border-radius:14px; max-width:520px; width:100%;
    max-height:88vh; overflow-y:auto; padding:26px;
  }
  .modal h2{ margin:0 0 18px; font-size:1.4rem; color:var(--plum-dark); }
  .field{ margin-bottom:16px; }
  .field label{ display:block; font-size:0.85rem; font-weight:500; margin-bottom:6px; color:var(--ink-soft); }
  .field input[type=text], .field textarea{
    width:100%; border:1px solid var(--line); border-radius:8px; padding:10px 12px;
    font-family:'Work Sans',sans-serif; font-size:0.92rem; color:var(--ink); background:#fff;
    resize:vertical;
  }
  .field textarea{ min-height:90px; }
  .checkrow{ display:flex; gap:16px; flex-wrap:wrap; }
  .checkrow label{ display:flex; align-items:center; gap:6px; font-weight:400; color:var(--ink); font-size:0.9rem; }
  .modal-actions{ display:flex; justify-content:space-between; align-items:center; margin-top:20px; gap:10px; }
  .danger-link{ color:#9B3A3A; background:none; border:none; font-size:0.85rem; cursor:pointer; text-decoration:underline; padding:0; }

  .overlay.fullpage{ padding:0; align-items:stretch; }
  .overlay.fullpage .modal{
    max-width:100%; width:100%; height:100%; max-height:100%; border-radius:0;
    display:flex; flex-direction:column; padding:0;
  }
  .picker-header{
    position:sticky; top:0; background:var(--paper); z-index:2;
    padding:20px 20px 14px; border-bottom:1px solid var(--line);
    display:flex; align-items:center; justify-content:space-between; gap:12px;
  }
  .picker-header h2{ margin:0; font-size:1.25rem; }
  .picker-close{ background:none; border:none; font-size:1.4rem; color:var(--ink-soft); cursor:pointer; line-height:1; padding:4px; }
  .picker-search{
    margin:14px 20px 4px; border:1px solid var(--line); border-radius:8px; padding:10px 12px;
    font-family:'Work Sans',sans-serif; font-size:0.92rem; width:calc(100% - 40px);
  }
  .picker-body{ flex:1; overflow-y:auto; padding:10px 20px 20px; }
  .overlay.fullpage .picker-list{ max-height:none; }
  .overlay.fullpage .picker-empty-slot-actions{ padding:0 20px 20px; margin-top:0; }

  .picker-list{ display:flex; flex-direction:column; gap:8px; max-height:340px; overflow-y:auto; }
  .picker-item{
    display:flex; justify-content:space-between; align-items:center;
    border:1px solid var(--line); border-radius:8px; padding:10px 12px; cursor:pointer;
  }
  .picker-item:hover{ border-color:var(--sage); background:#F5F7EF; }
  .picker-item .name{ font-weight:500; font-size:0.92rem; }
  .picker-item .tag{ font-size:0.72rem; color:var(--mustard); font-weight:600; }
  .picker-empty-slot-actions{ display:flex; gap:8px; margin-top:14px; }

  .ing-row{ display:flex; gap:6px; margin-bottom:8px; align-items:center; }
  .ing-row input[type=text]{ border:1px solid var(--line); border-radius:8px; padding:8px 10px; font-family:'Work Sans',sans-serif; font-size:0.88rem; background:#fff; }
  .ing-row .ing-nome{ flex:1; }
  .ing-row .ing-qtd{ width:64px; }
  .ing-row select.ing-unidade{ width:78px; border:1px solid var(--line); border-radius:8px; padding:8px 6px; font-family:'Work Sans',sans-serif; font-size:0.84rem; background:#fff; }
  .ing-row .ing-remove{ background:none; border:none; color:var(--ink-soft); cursor:pointer; font-size:1.1rem; padding:0 4px; }
  .ing-row .ing-remove:hover{ color:#9B3A3A; }

  .shop-group{ margin-bottom:18px; }
  .shop-group h3{ font-size:0.95rem; margin:0 0 8px; color:var(--plum-dark); }
  .shop-item{
    display:flex; align-items:center; gap:10px; padding:9px 4px;
    border-bottom:1px solid var(--line); font-size:0.92rem;
  }
  .shop-item.checked{ color:var(--ink-soft); text-decoration:line-through; }
  .shop-empty{ text-align:center; padding:40px 20px; color:var(--ink-soft); }

  .fridge-card{
    background:var(--paper); border:1px solid var(--line); border-radius:12px;
    padding:14px 16px; margin-bottom:10px; box-shadow:var(--shadow);
  }
  .fridge-card h4{ margin:0 0 4px; font-size:1rem; }
  .fridge-card .badge{
    display:inline-block; font-size:0.7rem; font-weight:600; border-radius:12px;
    padding:2px 9px; margin-bottom:6px;
  }
  .badge.completo{ background:#DCE9D5; color:#3B5C2B; }
  .badge.quase{ background:var(--mustard-soft); color:#7A5310; }
  .fridge-card .faltando{ font-size:0.82rem; color:var(--ink-soft); }
  .fridge-preview-img{ max-width:220px; border-radius:10px; margin-bottom:10px; display:block; }

  /* AUTH / HOUSEHOLD GATE */
  .gate-wrap{
    min-height:100vh; display:flex; align-items:center; justify-content:center;
    padding:24px; background:var(--bg);
  }
  .gate-card{
    background:var(--paper); border-radius:16px; padding:32px 28px; max-width:400px; width:100%;
    box-shadow:0 4px 24px rgba(43,35,32,0.08);
  }
  .gate-logo{ display:flex; align-items:center; gap:10px; margin-bottom:22px; }
  .gate-logo h1{ font-size:1.4rem; margin:0; color:var(--plum-dark); }
  .gate-card h2{ font-size:1.15rem; margin:0 0 16px; }
  .gate-card .field input{
    width:100%; border:1px solid var(--line); border-radius:8px; padding:11px 12px;
    font-family:'Work Sans',sans-serif; font-size:0.92rem; margin-bottom:12px;
  }
  .gate-card .primary-btn{ width:100%; padding:11px; font-size:0.95rem; margin-top:4px; }
  .gate-switch{ text-align:center; margin-top:16px; font-size:0.85rem; color:var(--ink-soft); }
  .gate-switch a{ color:var(--plum); cursor:pointer; text-decoration:underline; }
  .gate-error{ color:#9B3A3A; font-size:0.85rem; margin:-6px 0 12px; }
  .gate-divider{ text-align:center; color:var(--ink-soft); font-size:0.8rem; margin:18px 0; }
  .header-logo{ display:inline-flex; vertical-align:middle; margin-right:10px; }
  #logout-btn{ background:none; border:1px solid var(--line); border-radius:20px; padding:6px 14px; font-size:0.8rem; color:var(--ink-soft); cursor:pointer; }

  .toast{
    position:fixed; bottom:24px; left:50%; transform:translateX(-50%);
    background:var(--plum-dark); color:var(--paper); padding:10px 18px; border-radius:20px;
    font-size:0.87rem; z-index:100; opacity:0; pointer-events:none; transition:opacity .2s ease;
  }
  .toast.show{ opacity:1; }

  @media (max-width:680px){
    .daytab{ padding:6px 10px; }
    .daytab strong{ font-size:0.82rem; }
    .slot .rname{ font-size:1rem; }
  }
</style>
</head>
<body>

<div id="gate-login" class="gate-wrap">
  <div class="gate-card">
    <div class="gate-logo">
      <svg class="header-logo" width="34" height="34" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <path d="M 12.3 51.8 A 24 24 0 1 1 12.3 24.2" fill="none" stroke="#A23B55" stroke-width="9" stroke-linecap="round"/>
        <path d="M 41.6 77.5 A 20 20 0 1 1 41.6 54.5" fill="none" stroke="#E0982A" stroke-width="9" stroke-linecap="round"/>
        <circle cx="45" cy="52" r="3.2" fill="#4E9A5C"/>
      </svg>
      <h1>Cardápio da Casa</h1>
    </div>
    <h2 id="auth-title">Entrar</h2>
    <div class="gate-error" id="auth-error" style="display:none;"></div>
    <div class="field"><input type="email" id="auth-email" placeholder="E-mail"></div>
    <div class="field"><input type="password" id="auth-password" placeholder="Senha"></div>
    <button class="primary-btn" id="auth-submit">Entrar</button>
    <div class="gate-switch">
      <span id="auth-switch-text">Ainda não tem conta?</span> <a id="auth-switch-link">Criar conta</a>
    </div>
  </div>
</div>

<div id="gate-household" class="gate-wrap" style="display:none;">
  <div class="gate-card">
    <div class="gate-logo">
      <svg class="header-logo" width="34" height="34" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <path d="M 12.3 51.8 A 24 24 0 1 1 12.3 24.2" fill="none" stroke="#A23B55" stroke-width="9" stroke-linecap="round"/>
        <path d="M 41.6 77.5 A 20 20 0 1 1 41.6 54.5" fill="none" stroke="#E0982A" stroke-width="9" stroke-linecap="round"/>
        <circle cx="45" cy="52" r="3.2" fill="#4E9A5C"/>
      </svg>
      <h1>Cardápio da Casa</h1>
    </div>
    <h2>Crie a cozinha da sua casa</h2>
    <div class="gate-error" id="house-error" style="display:none;"></div>
    <div class="field"><input type="text" id="house-name" placeholder="Nome da casa (ex: Casa da Ana)"></div>
    <button class="primary-btn" id="house-create-btn">Criar</button>
    <div class="gate-divider">— ou —</div>
    <h2>Já tem um código?</h2>
    <div class="field"><input type="text" id="house-code" placeholder="Código de convite"></div>
    <button class="primary-btn" id="house-join-btn" style="background:var(--sage);">Entrar com código</button>
  </div>
</div>

<div id="app-main" style="display:none;">
<div class="wrap">
  <header class="top">
    <div style="display:flex; align-items:center;">
      <svg class="header-logo" width="30" height="30" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <path d="M 12.3 51.8 A 24 24 0 1 1 12.3 24.2" fill="none" stroke="#A23B55" stroke-width="9" stroke-linecap="round"/>
        <path d="M 41.6 77.5 A 20 20 0 1 1 41.6 54.5" fill="none" stroke="#E0982A" stroke-width="9" stroke-linecap="round"/>
        <circle cx="45" cy="52" r="3.2" fill="#4E9A5C"/>
      </svg>
      <div>
        <h1>Cardápio da Casa</h1>
        <p>Monte a semana, guarde as receitas, deixe o app sugerir o resto. <span id="household-name-label"></span></p>
      </div>
    </div>
    <div style="display:flex; align-items:center; gap:8px;">
      <button id="settings-btn" title="Configurações" style="background:none; border:1px solid var(--line); border-radius:50%; width:36px; height:36px; font-size:1.1rem; cursor:pointer;">⚙️</button>
      <button id="logout-btn">Sair</button>
    </div>
  </header>

  <nav class="tabs">
    <button id="tab-week" class="active">Semana</button>
    <button id="tab-shopping">Lista de compras</button>
    <button id="tab-fridge">Da geladeira</button>
    <button id="tab-ask">Perguntar</button>
    <button id="tab-library">Receitas</button>
  </nav>

  <section id="view-week">
    <div class="weeknav">
      <div class="btns">
        <button class="iconbtn" id="prev-week">‹</button>
        <button class="iconbtn" id="next-week">›</button>
      </div>
      <div class="range" id="week-range">—</div>
      <div style="display:flex; gap:8px; flex-wrap:wrap;">
