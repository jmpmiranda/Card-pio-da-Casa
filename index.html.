  overlay.querySelector('#chooser-cancel').onclick = ()=>overlay.remove();
  overlay.querySelectorAll('.picker-item').forEach(item=>{
    item.onclick = ()=>{
      const d = dishes.find(x=>x.id===item.dataset.id);
      overlay.remove();
      onPick(d);
    };
  });
}

