}

async function loadRules(){
  const { data } = await sb.from('rules').select('rules').eq('household_id', currentHouseholdId).maybeSingle();
  rules = (data && data.rules) ? data.rules : {};
}
async function saveRules(){
  await sb.from('rules').upsert({ household_id: currentHouseholdId, rules });
}

async function loadCombos(){
  const { data, error } = await sb.from('combos').select('*').eq('household_id', currentHouseholdId).order('created_at');
  combos = error ? [] : data.map(c=>({ id:c.id, nome:c.nome, recipeIds:c.recipe_ids||[] }));
}
async function createComboRow(nome, recipeIds){
  const { data: row, error } = await sb.from('combos').insert({ household_id: currentHouseholdId, nome, recipe_ids: recipeIds }).select().single();
  if(error) throw error;
  combos.push({ id: row.id, nome, recipeIds });
}

async function loadWeek(monday){
  const { data } = await sb.from('week_menus').select('slots,pessoas').eq('household_id', currentHouseholdId).eq('week_start', isoDate(monday)).maybeSingle();
  const rawSlots = (data && data.slots) ? data.slots : {};
  const slots = {};
  Object.keys(rawSlots).forEach(k=>{
    const v = rawSlots[k];
    slots[k] = Array.isArray(v) ? v : (v ? [v] : []);
  });
  const pessoas = (data && data.pessoas) ? data.pessoas : {};
  return { slots, pessoas };
}
async function persistWeek(){
  await sb.from('week_menus').upsert({
    household_id: currentHouseholdId, week_start: isoDate(currentWeekStart),
    slots: currentSlots, pessoas: currentPeople
  });
}
async function loadAllPastWeeksWithDates(){
  const { data, error } = await sb.from('week_menus').select('week_start,slots').eq('household_id', currentHouseholdId);
  if(error || !data) return [];
  return data.map(w=>{
    const rawSlots = w.slots || {};
    const slots = {};
    Object.keys(rawSlots).forEach(k=>{
      const v = rawSlots[k];
      slots[k] = Array.isArray(v) ? v : (v ? [v] : []);
    });
    return { weekStart: w.week_start, slots };
  });
}
