        </div>
      </div>
    </div>
  `;
  document.getElementById('overlay-root').appendChild(overlay);
  overlay.querySelector('#picker-close').onclick = ()=>overlay.remove();

  if(relevantCombos.length){
    const comboBox = overlay.querySelector('#combo-list');
    relevantCombos.forEach(c=>{
      const div = document.createElement('div');
      div.className = 'combo-item';
      const names = c.recipeIds.map(id=>recipeById(id)).filter(Boolean).map(r=>r.name).join(' + ');
      div.innerHTML = `<div class="combo-title">${escapeHtml(c.nome)}</div><div class="combo-items">${escapeHtml(names)}</div>`;
      div.onclick = async ()=>{
        const set = new Set(currentSlots[key] || []);
        c.recipeIds.forEach(id=>set.add(id));
        currentSlots[key] = Array.from(set);
        await persistWeek();
        renderDaySlots();
        overlay.remove();
      };
      comboBox.appendChild(div);
    });
  }

  function renderList(filter){
    const list = overlay.querySelector('#picker-list');
    if(!list) return;
    list.innerHTML = '';
    const term = (filter||'').toLowerCase().trim();
    const filtered = options.filter(r =>
      !term || r.name.toLowerCase().includes(term) || (r.categoria||'').toLowerCase().includes(term)
    );
    if(filtered.length===0){
      list.innerHTML = `<p style="color:var(--ink-soft); font-size:0.88rem;">Nenhuma receita encontrada.</p>`;
      return;
    }
    filtered.forEach(r=>{
      const added = alreadyIn.has(r.id);
      const item = document.createElement('div');
      item.className = 'picker-item';
      if(added) item.style.opacity = '0.55';
      item.innerHTML = `
        <span class="name">${escapeHtml(r.name)}</span>
        ${r.categoria ? `<span class="cat-chip" style="background:${categoryColor(r.categoria)}">${escapeHtml(r.categoria)}</span>` : ''}
        ${added ? `<span style="font-size:0.75rem; color:var(--sage); margin-left:6px;">✓ adicionada</span>` : ''}
      `;
      item.onclick = async ()=>{
        if(added) return;
        const set = new Set(currentSlots[key] || []);
        set.add(r.id);
