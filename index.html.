  let aiPhotoBase64 = null, aiPhotoMediaType = null;
  overlay.querySelector('#ai-photo-btn').onclick = ()=>overlay.querySelector('#ai-photo-input').click();
  overlay.querySelector('#ai-photo-input').onchange = async (e)=>{
    const file = e.target.files[0];
    if(!file) return;
    aiPhotoMediaType = file.type;
    aiPhotoBase64 = await new Promise((res,rej)=>{
      const r = new FileReader();
      r.onload = ()=>res(r.result.split(',')[1]);
      r.onerror = ()=>rej(new Error('Falha ao ler imagem'));
      r.readAsDataURL(file);
    });
    overlay.querySelector('#ai-photo-name').textContent = file.name;
  };

  overlay.querySelector('#ai-extract-btn').onclick = async ()=>{
    const status = overlay.querySelector('#ai-extract-status');
    const name = overlay.querySelector('#f-name').value.trim();
    const pastedText = overlay.querySelector('#ai-paste-text').value.trim();
    const link = overlay.querySelector('#ai-link').value.trim();
    if(!name){ toast('Escreve o nome da receita primeiro'); return; }
    if(!aiPhotoBase64 && !pastedText && !link){ toast('Anexa uma foto, cola um texto ou um link'); return; }

    let linkText = '';
    if(link){
      status.textContent = 'Abrindo o link...';
      try{
        const resp = await fetch(link);
        const html = await resp.text();
        linkText = html.replace(/<[^>]+>/g,' ').replace(/\s+/g,' ').slice(0,6000);
      }catch(e){
        status.textContent = 'Não consegui abrir esse link direto — copiei só o que você colou de texto, se tiver.';
      }
    }

    status.textContent = 'Lendo a receita...';
    const contentParts = [];
    if(aiPhotoBase64){
      contentParts.push({ inline_data:{ mime_type: aiPhotoMediaType, data: aiPhotoBase64 } });
    }
    const promptText = `Nome da receita: ${name}
${pastedText ? `Texto colado pela pessoa:\n${pastedText}\n` : ''}
${linkText ? `Texto extraído do link:\n${linkText}\n` : ''}
Monte os dados dessa receita a partir do que está disponível (foto e/ou textos acima). Responda SOMENTE com um JSON válido, sem markdown, neste formato exato:
{"ingredientes":[{"nome":"...","quantidade":numero_ou_vazio,"unidade":"g|kg|ml|l|un|xíc|csopa|cchá|pitada"}],"instructions":"passo a passo em texto corrido","categoria":"uma palavra tipo sopa, massa, peixe, salada, carne, doce...","porcoes":numero_de_pessoas_que_a_receita_serve}
Se não achar quantidade de algum ingrediente, deixe quantidade como "" e ainda assim inclua o ingrediente. Se não souber o número de porções, use 4.`;
    contentParts.push({ text: promptText });

    try{
      const clean = await callGemini(contentParts, true);
      const parsed = JSON.parse(clean);

      if(parsed.ingredientes && parsed.ingredientes.length){
        formIngredients = parsed.ingredientes.map(i=>({
          id: uid(), nome: i.nome||'', quantidade: i.quantidade || '',
          unidade: UNIDADES.includes(i.unidade) ? i.unidade : 'un'
        }));
        renderIngRows();
      }
      if(parsed.instructions) overlay.querySelector('#f-instructions').value = parsed.instructions;
      if(parsed.categoria) overlay.querySelector('#f-categoria').value = parsed.categoria;
      if(parsed.porcoes) overlay.querySelector('#f-porcoes').value = parsed.porcoes;
      status.textContent = 'Preenchido! Dá uma conferida antes de salvar.';
    }catch(err){
      status.textContent = 'Não consegui ler essa receita agora. Tenta de novo ou preenche na mão.';
    }
  };

  overlay.querySelector('#f-save').onclick = async ()=>{
    const name = overlay.querySelector('#f-name').value.trim();
    if(!name){ toast('Dê um nome para a receita'); return; }
    const meals = [];
    if(overlay.querySelector('#f-almoco').checked) meals.push('almoco');
    if(overlay.querySelector('#f-jantar').checked) meals.push('jantar');
    const ingredientes = formIngredients
      .filter(i=>i.nome.trim())
      .map(i=>({ id: i.id, nome: i.nome.trim(), quantidade: i.quantidade ? parseFloat(String(i.quantidade).replace(',','.')) || i.quantidade : '', unidade: i.unidade }));
    const data = {
      name, ingredientes,
      instructions: overlay.querySelector('#f-instructions').value.trim(),
      categoria: overlay.querySelector('#f-categoria').value.trim(),
      porcoes: parseFloat(overlay.querySelector('#f-porcoes').value) || 4,
      meals
    };
    try{
      if(existing){
        await updateRecipeRow(existing.id, data);
      } else {
        await createRecipeRow(data);
      }
      await loadRecipes();
      renderLibrary();
      renderDaySlots();
      overlay.remove();
      toast('Receita salva');
    }catch(err){
      toast('Não consegui salvar a receita agora');
    }
  };

  const delBtn = overlay.querySelector('#f-delete');
  if(delBtn){
    delBtn.onclick = async ()=>{
      if(!confirm('Excluir esta receita?')) return;
      await deleteRecipeRow(existing.id);
      await loadRecipes();
      renderLibrary();
      renderDaySlots();
      overlay.remove();
      toast('Receita excluída');
    };
  }
}

document.getElementById('fridge-photo-btn').onclick = ()=>document.getElementById('fridge-photo-input').click();

document.getElementById('fridge-photo-input').onchange = async (e)=>{
  const file = e.target.files[0];
  if(!file) return;
  const preview = document.getElementById('fridge-preview');
  const resultBox = document.getElementById('fridge-result');
  resultBox.innerHTML = '';

  const moment = document.querySelector('input[name="fridge-moment"]:checked').value;
  const momentLabel = {cafe:'café da manhã', almoco:'almoço', jantar:'jantar'}[moment];

  const base64Data = await new Promise((res, rej)=>{
    const r = new FileReader();
    r.onload = ()=>res(r.result.split(',')[1]);
    r.onerror = ()=>rej(new Error('Falha ao ler a imagem'));
    r.readAsDataURL(file);
  });
  preview.innerHTML = `<img class="fridge-preview-img" src="data:${file.type};base64,${base64Data}">`;
  resultBox.innerHTML = `<p style="color:var(--ink-soft);">Olhando a foto...</p>`;

  const recipeSummary = recipes.map(r => ({
    nome: r.name,
    refeicoes: r.meals||[],
    ingredientes: (r.ingredientes||[]).map(i=>i.nome)
  }));

  const prompt = `Olhe a foto da geladeira/despensa. Liste os alimentos que reconhece, incluindo o que conseguir identificar em marcas ou embalagens.

O momento escolhido é: ${momentLabel}.

Receitas já cadastradas nesta casa (nome, refeições que servem, ingredientes): ${JSON.stringify(recipeSummary)}

Responda SOMENTE com um JSON válido, sem markdown, neste formato exato:
{
  "itensVistos": ["item1","item2"],
  "receitasCasa": [{"nome":"nome de uma receita da lista acima","status":"completo ou quase","faltando":["item que falta"]}],
  "ideias": [{"nome":"nome de um prato simples pra ${momentLabel}","resumo":"resumo curto de como fazer, 1-2 frases","usa":["itens da foto usados"]}]
}

Em "receitasCasa" só inclua receitas da lista que dá pra fazer completas ou faltando no máximo 2 itens. Em "ideias" sugira de 2 a 4 pratos adequados pra ${momentLabel} usando principalmente o que apareceu na foto — pode ser prato simples do dia a dia da cozinha brasileira, mesmo que não esteja na lista de receitas da casa.`;

  try{
    const clean = await callGemini([
      { inline_data: { mime_type: file.type, data: base64Data } },
      { text: prompt }
    ], true);
    const parsed = JSON.parse(clean);
    renderFridgeResult(parsed);
  }catch(err){
    resultBox.innerHTML = `<p style="color:#9B3A3A;">Não consegui analisar a foto agora. Tenta de novo em instantes.</p>`;
  }
};

function renderFridgeResult(parsed){
  const resultBox = document.getElementById('fridge-result');
  resultBox.innerHTML = '';
  if(parsed.itensVistos && parsed.itensVistos.length){
    const p = document.createElement('p');
    p.style.cssText = 'font-size:0.85rem; color:var(--ink-soft); margin-bottom:14px;';
    p.textContent = `Vi na foto: ${parsed.itensVistos.join(', ')}`;
    resultBox.appendChild(p);
  }
  if(parsed.receitasCasa && parsed.receitasCasa.length){
    const title = document.createElement('div');
    title.className = 'combo-section-title';
    title.textContent = 'Das suas receitas';
    resultBox.appendChild(title);
    parsed.receitasCasa.forEach(rec=>{
      const card = document.createElement('div');
      card.className = 'fridge-card';
      const badge = rec.status === 'completo' ? '<span class="badge completo">Dá pra fazer</span>' : '<span class="badge quase">Falta pouco</span>';
      const faltando = (rec.faltando && rec.faltando.length) ? `<div class="faltando">Falta: ${rec.faltando.map(escapeHtml).join(', ')}</div>` : '';
      card.innerHTML = `${badge}<h4>${escapeHtml(rec.nome)}</h4>${faltando}`;
      resultBox.appendChild(card);
    });
  }
  if(parsed.ideias && parsed.ideias.length){
    const title = document.createElement('div');
    title.className = 'combo-section-title';
    title.style.marginTop = '18px';
    title.textContent = 'Ideias novas';
    resultBox.appendChild(title);
    parsed.ideias.forEach(idea=>{
      const card = document.createElement('div');
      card.className = 'fridge-card';
      card.innerHTML = `<h4>${escapeHtml(idea.nome)}</h4><p style="font-size:0.85rem; color:var(--ink-soft); margin:4px 0 0;">${escapeHtml(idea.resumo||'')}</p>`;
      resultBox.appendChild(card);
    });
  }
  if((!parsed.receitasCasa || !parsed.receitasCasa.length) && (!parsed.ideias || !parsed.ideias.length)){
    resultBox.innerHTML += `<p style="color:var(--ink-soft);">Não achei nada certeiro com o que apareceu na foto.</p>`;
  }
}

function renderChatSuggestions(){
  const box = document.getElementById('chat-suggestions');
  if(chatHistory.length>0){ box.innerHTML=''; return; }
  const chips = [
    'O que tem pra hoje?',
    'Sugere algo com frango',
    'O que fica bom com arroz e feijão?',
    'Alguma receita rápida pro jantar?'
  ];
  box.innerHTML = '';
  chips.forEach(c=>{
    const chip = document.createElement('div');
    chip.className = 'chat-chip';
    chip.textContent = c;
    chip.onclick = ()=>sendChatMessage(c);
    box.appendChild(chip);
  });
}

function renderChatLog(){
  const log = document.getElementById('chat-log');
  log.innerHTML = '';
  chatHistory.forEach(m=>{
    const div = document.createElement('div');
    div.className = 'chat-msg ' + m.role;
    div.textContent = m.content;
    log.appendChild(div);
  });
  log.scrollTop = log.scrollHeight;
}

async function sendChatMessage(text){
  text = (text||'').trim();
  if(!text) return;
  document.getElementById('chat-suggestions').innerHTML = '';
  chatHistory.push({ role:'user', content:text });
  renderChatLog();
  document.getElementById('chat-input').value = '';

  const log = document.getElementById('chat-log');
  const thinking = document.createElement('div');
  thinking.className = 'chat-msg thinking';
  thinking.textContent = 'Pensando...';
  log.appendChild(thinking);
  log.scrollTop = log.scrollHeight;

  const recipeSummary = recipes.map(r => ({
    nome: r.name, categoria: r.categoria||'', refeicoes: r.meals||[],
    ingredientes: (r.ingredientes||[]).map(i=>i.nome)
  }));
  const weekSummary = {};
  DAYS.forEach(day=>{
    MEALS.forEach(meal=>{
      const ids = currentSlots[`${day}-${meal}`] || [];
      const names = ids.map(id=>recipeById(id)).filter(Boolean).map(r=>r.name);
      if(names.length) weekSummary[`${DAY_LABELS[day]} ${MEAL_LABELS[meal]}`] = names.join(' + ');
    });
  });
  const comboSummary = combos.map(c=>({ nome:c.nome, receitas: c.recipeIds.map(id=>recipeById(id)).filter(Boolean).map(r=>r.name) }));

  const systemContext = `Você é o assistente do app "Cardápio da Casa", ajudando quem cuida da cozinha (pode ser a babá ou alguém da família) a decidir o que cozinhar.
Receitas cadastradas: ${JSON.stringify(recipeSummary)}
Cardápio já planejado para esta semana: ${JSON.stringify(weekSummary)}
Combos que costumam ir juntos: ${JSON.stringify(comboSummary)}

Responda em português, de forma direta e curta (poucas frases), baseando-se primeiro nessas receitas cadastradas. Se a pergunta pedir uma ideia nova que não existe na lista, sugira algo com base no seu conhecimento geral de cozinha brasileira do dia a dia, deixando claro que é uma sugestão nova, não uma receita salva na casa.`;

  try{
    const textOut = await callGemini([{ text: systemContext + '\n\nPergunta: ' + text }], false);
    thinking.remove();
    chatHistory.push({ role:'assistant', content: textOut || 'Não consegui pensar em uma resposta agora.' });
    renderChatLog();
  }catch(err){
    thinking.remove();
    chatHistory.push({ role:'assistant', content: 'Não consegui responder agora. Tenta de novo em instantes.' });
    renderChatLog();
  }
}

document.getElementById('chat-send').onclick = ()=>sendChatMessage(document.getElementById('chat-input').value);
document.getElementById('chat-input').addEventListener('keydown', (e)=>{
  if(e.key==='Enter') sendChatMessage(document.getElementById('chat-input').value);
});

